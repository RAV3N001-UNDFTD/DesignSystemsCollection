      "files": [
        {
          "path": "registry/items/blocks/project-grid/project-grid.tsx",
          "type": "registry:component",
          "target": "components/blocks/project-grid.tsx"
        },
        {
          "path": "registry/items/blocks/project-grid/project-grid.rules.md",
          "type": "registry:file",
          "target": "components/blocks/project-grid.rules.md"
        }
      ]
    }
  ]
}
