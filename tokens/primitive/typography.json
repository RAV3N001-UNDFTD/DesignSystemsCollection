{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": { "$value": ["Inter", "system-ui", "-apple-system", "sans-serif"] },
      "mono": { "$value": ["JetBrains Mono", "ui-monospace", "SFMono-Regular", "monospace"] }
    },
    "size": {
      "$type": "dimension",
      "100": { "$value": "0.75rem", "$description": "12px — 辅助标注、legal 文本" },
      "200": { "$value": "0.875rem", "$description": "14px — 小号正文、表格、代码" },
      "300": { "$value": "1rem", "$description": "16px — 默认正文" },
      "400": { "$value": "1.125rem", "$description": "18px" },
      "500": { "$value": "1.25rem", "$description": "20px" },
      "600": { "$value": "1.5rem", "$description": "24px" },
      "700": { "$value": "1.875rem", "$description": "30px" },
      "800": { "$value": "2.25rem", "$description": "36px" },
      "900": { "$value": "3rem", "$description": "48px — display 级，仅 hero 使用" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 }
    },
    "line-height": {
      "$type": "number",
      "100": { "$value": 1.2, "$description": "紧凑 — 大标题" },
      "200": { "$value": 1.375, "$description": "中等 — 小标题、UI 文本" },
      "300": { "$value": 1.5, "$description": "默认 — 正文" },
      "400": { "$value": 1.625, "$description": "宽松 — 长文阅读" }
    }
  }
}
